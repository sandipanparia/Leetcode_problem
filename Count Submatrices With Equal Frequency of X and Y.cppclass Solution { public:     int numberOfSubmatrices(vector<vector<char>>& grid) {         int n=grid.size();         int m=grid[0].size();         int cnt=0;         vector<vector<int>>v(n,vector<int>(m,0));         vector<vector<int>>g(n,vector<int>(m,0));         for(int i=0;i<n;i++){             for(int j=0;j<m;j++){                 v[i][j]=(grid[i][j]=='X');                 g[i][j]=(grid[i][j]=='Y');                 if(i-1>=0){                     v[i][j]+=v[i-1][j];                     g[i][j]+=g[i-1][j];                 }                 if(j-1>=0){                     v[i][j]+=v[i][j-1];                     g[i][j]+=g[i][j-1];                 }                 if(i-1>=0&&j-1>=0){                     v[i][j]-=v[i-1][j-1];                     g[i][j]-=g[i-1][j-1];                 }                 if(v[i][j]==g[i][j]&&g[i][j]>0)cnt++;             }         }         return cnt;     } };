class Solution {
public:
    int numberOfSubmatrices(vector<vector<char>>& grid) {
        int n=grid.size();
        int m=grid[0].size();
        int cnt=0;
        vector<vector<int>>v(n,vector<int>(m,0));
        vector<vector<int>>g(n,vector<int>(m,0));
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                v[i][j]=(grid[i][j]=='X');
                g[i][j]=(grid[i][j]=='Y');
                if(i-1>=0){
                    v[i][j]+=v[i-1][j];
                    g[i][j]+=g[i-1][j];
                }
                if(j-1>=0){
                    v[i][j]+=v[i][j-1];
                    g[i][j]+=g[i][j-1];
                }
                if(i-1>=0&&j-1>=0){
                    v[i][j]-=v[i-1][j-1];
                    g[i][j]-=g[i-1][j-1];
                }
                if(v[i][j]==g[i][j]&&g[i][j]>0)cnt++;
            }
        }
        return cnt;
    }
};
